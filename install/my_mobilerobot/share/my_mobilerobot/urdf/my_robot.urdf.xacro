<?xml version="1.0"?>
<robot name="my_mobilerobot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- ===== LỰA CHỌN PHẦN CỨNG (khối này được THÊM 2026-10-13) =====
         use_gazebo true  nghĩa là mô phỏng (plugin gz_ros2_control/GazeboSimSystem)
         use_gazebo false nghĩa là robot thật (plugin my_robot_hardware/MyRobotHardware)
         Các tham số còn lại chỉ dùng cho robot thật, có thể ghi đè từ dòng lệnh xacro.
         Lưu ý không dùng dấu hai chấm + khoảng trắng trong comment vì URDF bị parse YAML. -->
    <xacro:arg name="use_gazebo" default="false" />
    <!-- [SỬA 2026-10-13] Cổng THỰC TẾ đã đo được của board này là /dev/ttyUSB1
         (chip CP2102, VID:PID=10C4:EA60). Kiểm tra lại bằng: ls /dev/ttyUSB*
         Ghi đè khi chạy: ros2 launch ... serial_port:=/dev/ttyUSB0 -->
    <xacro:arg name="serial_port" default="/dev/ttyUSB1" />
    <xacro:arg name="baud_rate" default="115200" />
    <xacro:arg name="gear_ratio" default="34" />
    <!-- [SỬA 2026-10-13] encoder_cpr đổi 11 -> 44 (11 PPR x4 do decode cầu phương 4x). -->
    <xacro:arg name="encoder_cpr" default="44" />

    <xacro:property name="base_length" value="0.6" />
    <xacro:property name="base_width" value="0.4" />
    <xacro:property name="base_height" value="0.2" />
    <xacro:property name="wheel_radius" value="0.1" />
    <xacro:property name="wheel_length" value="0.05" />
    <xacro:property name="caster_radius" value="0.05" />

    <xacro:include filename="common_properties.xacro"/>

    <!-- [THÊM 2026-10-13] Chọn block ros2_control tương ứng với chế độ đang chạy.
         use_gazebo true  -> include gazebo_sim_control.xacro (mô phỏng Gazebo)
         use_gazebo false -> include gazebo_ros2_control.xacro (robot thật qua serial ESP32)
         Ghi chú - trước đây file này include thẳng gazebo_ros2_control.xacro nên khi chạy
         Gazebo cũng bị gắn plugin serial (MyRobotHardware) và Gazebo không chạy được.
         Nay tách đôi để CẢ HAI chế độ đều hoạt động (không xoá code cũ, chỉ tách file). -->
    <xacro:if value="$(arg use_gazebo)">
        <xacro:include filename="gazebo_ros2_control.xacro"/>
    </xacro:if>
    <xacro:unless value="$(arg use_gazebo)">
        <xacro:include filename="gazebo_sim_control.xacro"/>
    </xacro:unless>

    <xacro:include filename="camera.xacro"/>
    <xacro:include filename="lidar.xacro"/>
    
    <xacro:macro name="wheel" params="prefix">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
                <material name="blue"/>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
                </geometry>
            </collision>
            <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}" o_xyz="0 0 0" o_rpy="${pi/2} 0 0"/>
        </link>
    </xacro:macro>
    
    <link name="base_footprint"/>
    <link name="base_link">
        <visual>
            <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="green"/>
        </visual>
        <xacro:box_inertia m= "5.0" x= "${base_length}" y= "${base_width}" z= "${base_height}" o_xyz= "0 0  ${base_height/2.0}" o_rpy= "0 0 0"/>
        <collision> 
            <origin xyz= "0 0 0.1" rpy= "0 0 0"/>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
        </collision>
    </link>

    <xacro:wheel prefix="right"/>
    <xacro:wheel prefix="left"/>


    <link name="caster_wheel">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
            <material name="red"/>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <sphere radius="${caster_radius}"/>
            </geometry>
        </collision>
        <xacro:sphere_inertia m="0.5" r="${caster_radius}" o_xyz="0 0 0" o_rpy="0 0 0"/>
    </link>

    <joint name="joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <joint name="joint_caster" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>
        <origin xyz="${base_length/3} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    </joint>

    
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="${-base_length/4} ${-(base_width + wheel_length)/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

   
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="${-base_length/4} ${(base_width + wheel_length)/2} 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
</robot>