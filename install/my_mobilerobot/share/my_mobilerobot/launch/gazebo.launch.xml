<launch>
    <!-- [SỬA 2026-10-13] File được cập nhật để chọn đúng chế độ mô phỏng.
         robot_state_publisher nay truyền use_gazebo true vào xacro (trước đây không
         truyền nên xacro lấy mặc định và gắn nhầm plugin serial của robot thật).
         Việc nạp ros2_control trong Gazebo do controller.launch.xml đảm nhiệm với
         use_gazebo true + use_sim_time true. -->
    <!-- [THÊM 2026-10-13] Cho phép tắt rviz khi chạy mô phỏng (mặc định vẫn mở). -->
    <arg name="launch_rviz" default="true"/>
    <!-- Loại bỏ biến môi trường do VS Code bản SNAP tiêm vào (tránh lỗi GTK khi chạy rviz2/Gazebo) -->
    <set_env name="GTK_PATH" value=""/>
    <set_env name="GTK_EXE_PREFIX" value=""/>
    <set_env name="GTK_IM_MODULE_FILE" value=""/>
    <set_env name="GIO_MODULE_DIR" value=""/>
    <set_env name="LOCPATH" value=""/>

    <!-- Tạo môi trường / đường dẫn cho Gazebo -->
    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(find-pkg-share my_mobilerobot)/../"/>
    <let name="urdf_path" value="$(find-pkg-share my_mobilerobot)/urdf/my_robot.urdf.xacro"/>
    <let name="rviz_config_path" value="$(find-pkg-share my_mobilerobot)/rviz/config.rviz"/>
    <let name="gazebo_config_path" value="$(find-pkg-share my_mobilerobot)/config/gazebo_bridge.yaml"/>

    <!-- robot_state_publisher: dùng URDF với use_gazebo:=true (plugin GazeboSimSystem) -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path) use_gazebo:=true')"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- Khởi chạy Gazebo Sim -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(find-pkg-share my_mobilerobot)/worlds/test_world.sdf -r"/>
    </include>

    <!-- Spawn robot vào thế giới Gazebo -->
    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -name my_mobilerobot -z 0.1"/>

    <!-- Cầu nối ROS 2 <-> Gazebo -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge" output="screen">
        <param name="config_file" value="$(var gazebo_config_path)"/>
        <param name="use_sim_time" value="true"/>
    </node>

    <!-- Nạp ros2_control + spawn 2 controller (dùng chung controller.launch.xml, chế độ mô phỏng) -->
    <include file="$(find-pkg-share mobile_controller)/launch/controller.launch.xml">
        <arg name="use_gazebo" value="true"/>
        <arg name="use_sim_time" value="true"/>
        <arg name="launch_rviz" value="true"/>
    </include>

    <!-- [SỬA 2026-10-13] rviz chỉ mở khi launch_rviz true (mặc định vẫn true như trước). -->
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" if="$(var launch_rviz)">
        <param name="use_sim_time" value="true"/>
    </node>
</launch>
