<launch>

<set_env name="GTK_PATH" value=""/>
<set_env name="GTK_EXE_PREFIX" value=""/>
<set_env name="GTK_IM_MODULE_FILE" value=""/>
<set_env name="GIO_MODULE_DIR" value=""/>
<set_env name="LOCPATH" value=""/>


<!--tao bien cuc bo luu duong dan den urdf/my_robot.urdf.xacro-->
<let name="urdf_path" value="$(find-pkg-share my_mobilerobot)/urdf/my_robot.urdf.xacro"/>

<!--Node đọc mô hình URDF và chuyển đổi cấu trúc khung (kinematic tree) thành các tọa độ không gian tf2-->
<node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
</node>

<!-- Khởi chạy một giao diện đồ họa (GUI) có các thanh trượt (sliders).-->
<!-- Node phát các góc/vị trí khớp lên /joint_states, từ đó robot_state_publisher lấy dữ liệu để cập nhật mô hình 3D real-time.-->
<node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui"/>

<node pkg="rviz2" exec="rviz2" name="rviz2" output="screen"/>
</launch>